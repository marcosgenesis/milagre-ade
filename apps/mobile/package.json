{
  "name": "@milagre/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "postinstall": "cd ../.. && patch-package --patch-dir apps/mobile/patches",
    "eas-build-post-install": "npm run postinstall",
    "start": "node ../../scripts/start-mobile.cjs",
    "android": "node ../../scripts/start-mobile.cjs --android",
    "ios": "node ../../scripts/start-mobile.cjs --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "export:ios": "expo export --platform ios",
    "lint": "eslint .",
    "update:testflight": "npx eas-cli@latest update --channel testflight --environment production --platform all --non-interactive"
  },
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react-native": "^1.0.16",
    "@milagre/shared": "0.1.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@sbaiahmed1/react-native-blur": "6.0.2",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.24",
    "markdown-it": "^15.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  }
}
