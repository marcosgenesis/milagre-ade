{
  "name": "@milagre/core",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "src/runtime.cjs",
  "exports": {
    ".": {
      "types": "./src/runtime.d.cts",
      "default": "./src/runtime.cjs"
    },
    "./*": "./src/*.cjs",
    "./editors": {
      "types": "./src/editors.d.cts",
      "default": "./src/editors.cjs"
    },
    "./keep-awake": {
      "types": "./src/keep-awake.d.cts",
      "default": "./src/keep-awake.cjs"
    }
  },
  "scripts": {
    "test": "node --test src/*.test.cjs src/agents/*.test.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "yaml": "^2.9.1",
    "@milagre/shared": "0.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
