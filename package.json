{
  "name": "milagre",
  "productName": "Milagre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5180\" \"wait-on http://127.0.0.1:5180 && MILAGRE_DEV_SERVER_URL=http://127.0.0.1:5180 node scripts/launch-electron.cjs\"",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/launch-electron.cjs",
    "typecheck": "tsc --noEmit",
    "test:agent": "node --test electron/*.test.cjs",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "electron-updater": "^6.8.9",
    "motion": "^13.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "semantic-release": "^25.0.9",
    "shadow-plugin": "^2.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.milagre.app",
    "productName": "Milagre",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app/public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "app/public/logo-milagre-image.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Milagre"
    },
    "publish": {
      "provider": "github",
      "owner": "marcosgenesis",
      "repo": "milagre-ade",
      "releaseType": "release"
    }
  }
}
