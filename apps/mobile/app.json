{
  "expo": {
    "name": "Milagre",
    "slug": "milagre",
    "scheme": ["milagre", "milagre-local"],
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "buildReactNativeFromSource": true
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#fafafb",
          "dark": {
            "image": "./assets/splash-mark-dark.png",
            "backgroundColor": "#17181a"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Milagre uses the camera to scan the pairing code your Mac shows.",
          "microphonePermission": "Milagre never records audio. iOS asks because the code scanner shares the camera.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Milagre attaches the photos you pick to a Chat.",
          "cameraPermission": "Milagre uses the camera to take a photo for a Chat.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "chats"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "./plugins/with-live-activity.cjs"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.victorlucas.milagre",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Milagre connects to your computer directly when you are on the same network."
      }
    },
    "android": {
      "package": "com.victorlucas.milagre",
      "permissions": ["android.permission.CAMERA"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53a87eea-769e-4d7c-a818-b9e2440cc065"
      }
    },
    "owner": "victorlucss",
    "updates": {
      "url": "https://u.expo.dev/53a87eea-769e-4d7c-a818-b9e2440cc065"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
