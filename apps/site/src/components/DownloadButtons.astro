---
import { DOWNLOAD_ARM64, DOWNLOAD_LINUX_APPIMAGE, DOWNLOAD_LINUX_DEB, DOWNLOAD_LINUX_RPM, DOWNLOAD_WINDOWS, DOWNLOAD_X64, IPHONE_BETA_URL } from "../links";
---
<!-- Every set ships; Base.astro marks iPhones, iPads, Windows and Linux before first paint, so each device sees its own. -->
<div class="downloads mac-only">
  <a class="button button-primary" href={DOWNLOAD_ARM64}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
    Download for macOS
  </a>
  <p class="notes"><a href={DOWNLOAD_X64}>Intel Mac</a></p>
</div>
<div class="downloads linux-only">
  <a class="button button-primary" href={DOWNLOAD_LINUX_APPIMAGE}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.5v8.2l2.9-2.9 1 1L8 12.4 4.1 7.8l1-1L8 9.7V1.5h0zM2.5 13h11v1.5h-11z"/></svg>
    Download for Linux
  </a>
  <p class="notes"><a href={DOWNLOAD_LINUX_DEB}>.deb</a><span aria-hidden="true">·</span><a href={DOWNLOAD_LINUX_RPM}>.rpm</a></p>
</div>
<div class="downloads windows-only">
  <a class="button button-primary" href={DOWNLOAD_WINDOWS}>
    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24"><path fill="currentColor" d="M0 0h11.377v11.372H0zm12.623 0H24v11.372H12.623zM0 12.623h11.377V24H0zm12.623 0H24V24H12.623z"/></svg>
    Download for Windows
  </a>
</div>
<div class="downloads ios-only">
  <a class="button button-primary" href={IPHONE_BETA_URL}>
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
    Get iOS beta
  </a>
</div>

<style>
  .downloads { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  /* Quiet links for the other builds of the same platform: Intel Mac, and .deb and .rpm next to the AppImage. */
  .notes { display: flex; gap: 8px; margin: 0; color: var(--ink-3); font-size: 13px; }
  .notes a { color: var(--ink-2); text-decoration: none; }
  .notes a:hover { color: var(--ink); text-decoration: underline; }
  .ios-only, .linux-only, .windows-only { display: none; }
  :global(html[data-platform="ios"]) .ios-only,
  :global(html[data-platform="linux"]) .linux-only,
  :global(html[data-platform="windows"]) .windows-only { display: flex; }
  :global(html[data-platform]) .mac-only { display: none; }
</style>
