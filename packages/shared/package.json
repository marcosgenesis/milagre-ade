{
  "name": "@milagre/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./model": "./src/model.ts",
    "./git-diff": "./src/git-diff.ts",
    "./agent-runs": {
      "types": "./src/agent-runs.d.mts",
      "default": "./src/agent-runs.mjs"
    },
    "./project-edits": {
      "types": "./src/project-edits.d.mts",
      "default": "./src/project-edits.mjs"
    },
    "./chats": {
      "types": "./src/chats.d.mts",
      "default": "./src/chats.mjs"
    },
    "./attention": {
      "types": "./src/attention.d.mts",
      "default": "./src/attention.mjs"
    },
    "./providers": {
      "types": "./src/providers.d.mts",
      "default": "./src/providers.mjs"
    },
    "./limits": {
      "types": "./src/limits.d.mts",
      "default": "./src/limits.mjs"
    },
    "./result": {
      "types": "./src/result.d.mts",
      "default": "./src/result.mjs"
    },
    "./git-codes": {
      "types": "./src/git-codes.d.mts",
      "default": "./src/git-codes.mjs"
    },
    "./model-options": "./src/model-options.ts",
    "./model-copy": "./src/model-copy.ts",
    "./reconcile": {
      "types": "./src/reconcile.d.mts",
      "default": "./src/reconcile.mjs"
    },
    "./reply-parts": "./src/reply-parts.ts",
    "./streaming-markdown": "./src/streaming-markdown.ts",
    "./pr-blockers": "./src/pr-blockers.ts",
    "./diff-parse": "./src/diff-parse.ts",
    "./diff-tree": "./src/diff-tree.ts",
    "./diff-layout": "./src/diff-layout.ts"
  },
  "files": [
    "src/*.mjs",
    "src/*.d.mts",
    "src/model.ts",
    "src/git-diff.ts",
    "src/model-options.ts",
    "src/model-copy.ts",
    "src/reply-parts.ts",
    "src/streaming-markdown.ts",
    "src/pr-blockers.ts",
    "src/diff-parse.ts",
    "src/diff-tree.ts",
    "src/diff-layout.ts"
  ],
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
