{
  "name": "milagre-monorepo",
  "productName": "Milagre",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "npm run dev --workspace milagre",
    "build": "node scripts/prepare-simulator-helper.cjs && npm run typecheck --workspace @milagre/shared && npm run build --workspace milagre",
    "start": "npm run start --workspace milagre",
    "typecheck": "npm run typecheck --workspace @milagre/shared && npm run typecheck --workspace milagre",
    "test:agent": "npm run test --workspace @milagre/shared && npm run test --workspace @milagre/core && npm run test:agent --workspace milagre && npm run test:daemon",
    "test:chat-titles": "node scripts/test-chat-titles.cjs",
    "test:handover": "node scripts/test-handover.cjs",
    "test:question-card": "node scripts/test-question-card.cjs",
    "test:chat-selections": "node scripts/test-chat-selections.cjs",
    "test:chat-timer": "node scripts/test-chat-timer.cjs",
    "test:chat-send-feedback": "node scripts/test-chat-send-feedback.cjs",
    "test:find-in-chat": "node scripts/test-find-in-chat.cjs",
    "test:subagents": "node scripts/test-subagents.cjs",
    "test:reply-thought": "node scripts/test-reply-thought.cjs",
    "test:image-generation": "node scripts/test-image-generation.cjs",
    "test:task-track": "node scripts/test-task-track.cjs",
    "test:ports": "node scripts/test-ports.cjs",
    "test:chat-attachments": "node scripts/test-chat-attachments.cjs",
    "test:chat-layout": "node scripts/test-chat-layout.cjs",
    "test:prompt-skills": "node scripts/test-prompt-skills.cjs",
    "test:diff-view": "node scripts/test-diff-view.cjs",
    "test:diff-comments": "node scripts/test-diff-comments.cjs",
    "test:sidebar-pr": "node scripts/test-sidebar-pr.cjs",
    "test:sidebar-usage": "node scripts/test-sidebar-usage.cjs",
    "test:sidebar-resize": "node scripts/test-sidebar-resize.cjs",
    "test:canvas-links": "node scripts/test-canvas-links.cjs",
    "test:project-cache": "node scripts/test-project-cache.cjs",
    "benchmark:chat-flow": "node scripts/benchmark-chat-flow.cjs",
    "benchmark:mobile-preview": "node scripts/benchmark-mobile-preview.cjs",
    "test:chat-order": "node scripts/test-chat-order.cjs",
    "test:chat-pins": "node scripts/test-chat-pins.cjs",
    "test:command-palette": "node scripts/test-command-palette.cjs",
    "test:archive-enter": "node scripts/test-archive-enter.cjs",
    "test:phone": "node scripts/test-phone.cjs",
    "test:ui": "npm run test:ui --workspace milagre",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci",
    "package:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb rpm --x64 --publish never",
    "package:managers": "node scripts/generate-package-managers.cjs",
    "test:release": "node --test scripts/release-workflow.test.cjs scripts/package-managers.test.cjs scripts/update-feeds.test.cjs scripts/linux-repository.test.cjs",
    "package:mac:local": "npm run package:mac -- --config.mac.identity=- --config.mac.notarize=false",
    "test:worktree-setup": "node scripts/test-worktree-setup.cjs",
    "test:monorepo": "node --test scripts/monorepo.test.cjs",
    "test:desktop": "node scripts/test-desktop.cjs",
    "test:core": "npm run test --workspace @milagre/core",
    "daemon": "node apps/daemon/src/cli.cjs",
    "test:daemon": "npm run test --workspace @milagre/daemon",
    "mobile": "npm run start --workspace @milagre/mobile",
    "mobile:demo": "node scripts/mobile-demo.cjs",
    "review:demo": "node scripts/review-demo.cjs",
    "mobile:host": "node scripts/mobile-host.cjs",
    "mobile:cloudflare": "node scripts/mobile-cloudflare.cjs",
    "test:relay": "npm run test --workspace @milagre/relay",
    "typecheck:relay": "npm run typecheck --workspace @milagre/relay",
    "typecheck:mobile": "npm run typecheck --workspace @milagre/mobile",
    "test:mobile": "npm run test --workspace @milagre/mobile && node --test scripts/mobile-demo.test.cjs scripts/review-demo.test.cjs scripts/mobile-host.test.cjs scripts/mobile-ui.test.cjs scripts/mobile-push-native.test.cjs scripts/mobile-tunnel.test.cjs scripts/mobile-cloudflare.test.cjs scripts/mobile-pairing.test.cjs",
    "test:delegation": "node scripts/test-delegation.cjs",
    "package:repositories": "node scripts/generate-linux-repository.cjs",
    "test:simulators": "node scripts/test-simulators.cjs",
    "test:project-links": "node scripts/test-project-links.cjs",
    "test:link-project-dialog": "node scripts/test-link-project-dialog.cjs"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "qrcode-terminal": "^0.12.0",
    "semantic-release": "^25.0.9",
    "yaml": "^2.9.1"
  },
  "build": {
    "appId": "com.milagre.app",
    "productName": "Milagre",
    "asar": true,
    "afterPack": "scripts/package-cloudflared.cjs",
    "asarUnpack": [
      "node_modules/@milagre/core/src/bundled-skills/**/*",
      "node_modules/expo-device-hub/**/*",
      "node_modules/node-datachannel/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "app/public/**/*",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!**/node_modules/shiki/**",
      "!**/node_modules/@shikijs/**"
    ],
    "directories": {
      "output": "release",
      "app": "apps/desktop"
    },
    "mac": {
      "artifactName": "Milagre-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "apps/desktop/app/public/logo-milagre-image.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "notarize": true
    },
    "dmg": {
      "title": "Milagre"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Milagre-Setup-${version}-${arch}.${ext}",
      "icon": "apps/desktop/app/public/logo-milagre-image.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "Milagre-${version}-${arch}.${ext}",
      "executableName": "milagre",
      "category": "Development",
      "maintainer": "Milagre contributors",
      "icon": "apps/desktop/app/public/logo-milagre-image.png",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "the-ptf",
      "repo": "milagre-ade",
      "releaseType": "release"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  }
}
