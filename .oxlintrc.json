{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "promise", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-shadow": "warn",
    "react/react-in-jsx-scope": "off",
    "typescript/no-explicit-any": "warn",
    "react-hooks/exhaustive-deps": "warn",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "react-native-get-random-values", "expo-router/entry"]
      }
    ],
    "no-console": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/consistent-function-scoping": "warn",
    "promise/always-return": "warn",
    "unicorn/no-array-sort": "warn",
    "unicorn/prefer-add-event-listener": "warn",
    "react/exhaustive-effect-dependencies": "warn",
    "react/refs": "warn",
    "react/set-state-in-effect": "warn",
    "eslint/no-unused-vars": "warn",
    "oxc/no-async-endpoint-handlers": "warn",
    "unicorn/no-useless-spread": "warn",
    "unicorn/no-array-reverse": "warn",
    "react/memo-dependencies": "warn",
    "eslint/preserve-caught-error": "warn",
    "no-await-in-loop": "off"
  },
  "ignorePatterns": ["**/dist/**", "**/release/**", "**/.expo/**", "apps/mobile/ios/**", "apps/mobile/android/**", "squashfs-root/**", "docs/**"],
  "overrides": [
    {
      "files": ["**/*.test.*", "scripts/test-*.cjs"],
      "rules": {
        "no-shadow": "off"
      }
    },
    {
      "files": ["apps/mobile/**"],
      "jsPlugins": ["./apps/mobile/lint/expo-env.mjs"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/error-boundaries": "error",
        "react/purity": "error",
        "react/set-state-in-render": "error",
        "react/display-name": "error",
        "react/no-unescaped-entities": "error",
        "react/jsx-key": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-string-refs": "error",
        "react/require-render-return": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-undef": "error",
        "eslint/no-var": "error",
        "import/namespace": "error",
        "import/export": "error",
        "expo/no-env-var-destructuring": "error",
        "expo/no-dynamic-env-var": "error",
        "react/incompatible-library": "warn",
        "react/unsupported-syntax": "warn",
        "react/no-unknown-property": "warn",
        "react/no-this-in-sfc": "warn",
        "import/first": "warn",
        "import/no-duplicates": "warn",
        "import/no-named-as-default": "warn",
        "import/no-named-as-default-member": "warn",
        "eslint/eqeqeq": ["warn", "smart"],
        "typescript/array-type": "warn",
        "typescript/no-empty-object-type": "warn",
        "typescript/no-wrapper-object-types": "warn",
        "typescript/consistent-type-assertions": "warn",
        "typescript/no-extra-non-null-assertion": "warn",
        "eslint/no-redeclare": "warn",
        "eslint/no-useless-constructor": "warn",
        "eslint/no-extend-native": "warn",
        "eslint/no-extra-bind": "warn",
        "eslint/no-unused-expressions": "warn",
        "eslint/unicode-bom": "warn"
      }
    }
  ]
}
