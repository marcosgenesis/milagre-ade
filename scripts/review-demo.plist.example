<?xml version="1.0" encoding="UTF-8"?>
<!--
  The App Review demo computer as a LaunchAgent: it starts at login and again whenever it exits.
  Not installed by anything in this repo. It runs from a dedicated worktree pinned to a reviewed commit, never from
  the main checkout, so a pull or a branch switch there cannot change what the reviewer's phone talks to.

    1. Make a detached worktree of the merged commit at /Users/Shared/milagre-review-demo-repo and run npm ci in it.
    2. Create "/Users/Shared/Milagre Review Demo" with mode 700: launchd opens the log there before the demo starts.
    3. Copy this file to ~/Library/LaunchAgents/com.milagre.review-demo.plist
    4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.milagre.review-demo.plist

  The pairing link is in "/Users/Shared/Milagre Review Demo/review-pairing-link.txt" (0600). The log never holds it.
  After Apple approves, reset the demo's phone token (daemon request phone:reset on that data dir) and then
  launchctl bootout gui/$(id -u)/com.milagre.review-demo. The exact commands are in the pull request that added this.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.milagre.review-demo</string>
  <key>ProgramArguments</key>
  <array>
    <!-- A login shell, so node and npm come from the same PATH as in Terminal (nvm, Homebrew). -->
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/Shared/milagre-review-demo-repo &amp;&amp; exec npm run review:demo</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/Shared/milagre-review-demo-repo</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- At most one restart every 30 seconds, e.g. while port 8899 is still taken. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- Inside the demo's private (0700) data dir, not ~/Library/Logs. -->
  <key>StandardOutPath</key>
  <string>/Users/Shared/Milagre Review Demo/review-demo.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/Shared/Milagre Review Demo/review-demo.log</string>
</dict>
</plist>
