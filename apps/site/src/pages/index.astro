---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import HeroDemo from "../components/HeroDemo.astro";
import DownloadButtons from "../components/DownloadButtons.astro";

const title = "Milagre: run Claude Code and Codex on your Mac, answer from anywhere";
const description = "Milagre runs Claude Code and Codex on your Mac, one Git Worktree per Chat. When an agent needs an approval or an answer, it shows up on your desk and on your iPhone.";
---
<Base title={title} description={description}>
  <div class="page">
    <Nav />
    <main class="hero container">
      <h1>Your agents keep working. <em>Answer them from anywhere.</em></h1>
      <div class="stage"><HeroDemo /></div>
    </main>
    <div class="fade" aria-hidden="true"></div>
    <div class="cta" data-cta><DownloadButtons /></div>
  </div>
</Base>

<style>
  /* One screen, no scroll. The devices rise from the bottom edge, which blurs and fades them out. */
  .page { position: relative; display: flex; flex-direction: column; height: 100vh; height: 100dvh; overflow: hidden; }
  .hero { display: flex; flex: 1; flex-direction: column; align-items: center; gap: clamp(22px, 3.6vh, 36px); min-height: 0; padding-top: clamp(20px, 4.5vh, 52px); text-align: center; }
  h1 { max-width: 22ch; font-size: clamp(32px, min(4.6vw, 5.8vh), 60px); font-weight: 600; letter-spacing: -0.035em; line-height: 1.05; }
  /* The payoff line in an italic serif, a touch larger so it reads at the same size as the grotesk. */
  h1 em { display: block; font-family: var(--font-serif); font-size: 1.12em; font-weight: 400; letter-spacing: -0.01em; color: oklch(0.86 0.06 255); }
  .stage { position: relative; flex: 1; width: 100%; min-height: 0; margin-top: clamp(8px, 2.5vh, 28px); }
  /* Blurs the devices more the lower they go, then fades them into the page, under the download button. */
  .fade { position: absolute; inset: auto 0 0; height: var(--fade, 240px); pointer-events: none; }
  .cta { position: absolute; inset: auto 0 0; z-index: 2; display: flex; justify-content: center; padding: 0 20px clamp(40px, calc(4vh + 20px), 56px); }
  .fade::before, .fade::after { content: ""; position: absolute; inset: 0; }
  .fade::before { backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); mask-image: linear-gradient(to bottom, transparent, black 70%); -webkit-mask-image: linear-gradient(to bottom, transparent, black 70%); }
  .fade::after { background: linear-gradient(to bottom, transparent, color-mix(in oklch, var(--page) 75%, transparent) 60%, var(--page)); }
  @media (max-width: 700px) {
    .hero { gap: 20px; padding-top: 16px; }
    .page { --fade: 180px; }
  }
</style>
